#!/usr/bin/env bash
#
# eac-dkms-workaround: keep DKMS-built NVIDIA modules for kernels without a
# prebuilt module (linux, linux-lts, linux-zen, linux-hardened, ...) while
# CachyOS's prebuilt EAC module (linux-cachyos-eac-nvidia-580xx or
# linux-cachyos-eac-nvidia-open) is installed.
#
# The NVIDIA DKMS packages declare `Conflicts = NVIDIA-MODULE`, and the EAC
# module packages provide NVIDIA-MODULE, so pacman refuses to keep both. Their
# files don't overlap, so this script never installs the DKMS package. It
# downloads it with pacman (signature checked), extracts only
# /usr/src/nvidia-<ver>/ and registers that tree with DKMS.
#
# DKMS builds for every kernel that has headers and no prebuilt nvidia module,
# except the EAC kernel. The tree's dkms.conf gets a BUILD_EXCLUSIVE_KERNEL
# pattern for those kernel flavors, so the official DKMS alpm hook rebuilds them
# on kernel updates. This script's pacman hook handles driver updates, and
# kernels or prebuilt modules being added or removed.
#
# SPDX-License-Identifier: MIT

set -u
shopt -s nullglob

# Supported driver lines: "<userspace package> <DKMS source package>". CachyOS
# builds each pair from one pkgbase, so their versions move together. The first
# installed userspace package wins.
readonly -a DRIVERS=(
    'nvidia-580xx-utils nvidia-580xx-dkms'  # Maxwell, Pascal, Volta (GTX 9xx/10xx)
    'nvidia-utils nvidia-open-dkms'         # Turing and newer (GTX 16xx, RTX)
)
readonly MOD=nvidia
readonly MARKER=.eac-dkms-workaround
# Lines around the block this script appends to the extracted dkms.conf.
readonly BLOCK_BEGIN='# >>> eac-dkms-workaround'
readonly BLOCK_END='# <<< eac-dkms-workaround'
readonly STAGE_PARENT=/var/tmp
# Not readonly, so the test suite can point them at fixture directories.
SRC_ROOT=/usr/src
MOD_ROOT=/usr/lib/modules
readonly ME=eac-dkms-workaround
# Package names this script is shipped as (their install also triggers the hook).
readonly -a PKG_NAMES=(eac-dkms-workaround eac-dkms-workaround-git)
readonly HOOK_NAME=80-eac-dkms-workaround.hook
# Manual install (sudo ./eac-dkms-workaround install) locations.
readonly SELF_DEST=/usr/local/bin/eac-dkms-workaround
readonly HOOK_DEST=/etc/pacman.d/hooks/$HOOK_NAME
# Package install location of the hook.
readonly PKG_HOOK=/usr/share/libalpm/hooks/$HOOK_NAME

UTILS_PKG=
DKMS_PKG=
HOOK_MODE=0
HOOK_TARGETS=()
TMP=
LOCK_FD=
REBUILT=()

log()  { printf '==> %s\n' "$*" >&2; }
warn() { printf '==> WARNING: %s\n' "$*" >&2; }
err()  { printf '==> ERROR: %s\n' "$*" >&2; }

# Abort sync. In hook mode exit 0 so pacman finishes the transaction cleanly.
fail() {
    err "$*"
    if (( HOOK_MODE )); then
        err "retry later with: sudo $ME sync"
        exit 0
    fi
    exit 1
}

run() {
    log "$*"
    "$@"
}

need_root() {
    if (( EUID != 0 )); then
        err "must be run as root: sudo $ME $1"
        exit 1
    fi
}

in_list() {
    local x=$1 e
    shift
    for e in "$@"; do
        [[ $e == "$x" ]] && return 0
    done
    return 1
}

# Serialize runs (hook vs. manual) with a lock on /usr/src; leaves no file.
take_lock() {
    exec {LOCK_FD}<"$SRC_ROOT" || fail "cannot open $SRC_ROOT"
    flock -n "$LOCK_FD" || fail "another $ME run is in progress"
}

cleanup() {
    if [[ -n $TMP && -d $TMP && $TMP == "$STAGE_PARENT"/eac-dkms.* ]]; then
        rm -rf -- "$TMP"
    fi
}

make_tmp() {
    TMP=$(mktemp -d -p "$STAGE_PARENT" eac-dkms.XXXXXX) || return 1
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP
    # pacman downloads as its DownloadUser (alpm), which must reach the cache dir.
    chmod 755 "$TMP"
}

# ---- packages ---------------------------------------------------------------

utils_packages() {
    local entry u d
    for entry in "${DRIVERS[@]}"; do
        read -r u d <<<"$entry"
        printf '%s\n' "$u"
    done
}

# Set UTILS_PKG and DKMS_PKG from the installed NVIDIA userspace package.
# `pacman -Qq` also resolves provides (nvidia-580xx-utils provides
# nvidia-utils), so compare the exact name.
detect_driver() {
    local entry u d
    for entry in "${DRIVERS[@]}"; do
        read -r u d <<<"$entry"
        if [[ $(pacman -Qq "$u" 2>/dev/null) == "$u" ]]; then
            UTILS_PKG=$u
            DKMS_PKG=$d
            return 0
        fi
    done
    return 1
}

no_driver_msg() {
    printf 'no supported NVIDIA userspace package is installed (%s)' "$(utils_packages | paste -sd' ')"
}

# Name of the installed package that ships this script, if any.
installed_as_package() {
    pacman -Qq "${PKG_NAMES[0]}" 2>/dev/null
}

pkg_version() {
    local v
    v=$(pacman -Q "$1" 2>/dev/null) || return 1
    printf '%s\n' "${v#* }"
}

repo_version() {
    pacman -Sddp --print-format '%v' "$1" 2>/dev/null
}

# 1:580.196.07-2 -> 580.196.07 (the version DKMS and /usr/src use)
upstream_version() {
    local v=${1%-*}
    printf '%s\n' "${v#*:}"
}

owned_by_package() {
    pacman -Qqo "$1" &>/dev/null
}

dkms_is_orphan() {
    [[ -n $(pacman -Qqdt dkms 2>/dev/null) ]]
}

# ---- kernels ----------------------------------------------------------------

# Installed kernels: every module directory with a kernel/ tree.
installed_kernels() {
    local d
    for d in "$MOD_ROOT"/*/kernel/; do
        d=${d%/kernel/}
        printf '%s\n' "${d##*/}"
    done
}

# The EAC kernel must only load its CachyOS-signed prebuilt module.
is_eac_kernel() {
    [[ $1 == *-eac ]]
}

has_headers() {
    [[ -d $MOD_ROOT/$1/build/include ]]
}

# A package-shipped module (e.g. linux-cachyos-nvidia-580xx) lives in extramodules/.
has_prebuilt_module() {
    local f
    for f in "$MOD_ROOT/$1/extramodules/$MOD".ko*; do
        return 0
    done
    return 1
}

# Kernels DKMS builds for: headers installed, no prebuilt module, not EAC.
eligible_kernels() {
    local k
    while read -r k; do
        has_headers "$k" || continue
        is_eac_kernel "$k" && continue
        has_prebuilt_module "$k" && continue
        printf '%s\n' "$k"
    done < <(installed_kernels)
}

kernel_pkgbase() {
    local k=$1 pb=
    [[ -f $MOD_ROOT/$k/pkgbase ]] && pb=$(<"$MOD_ROOT/$k/pkgbase")
    [[ -n $pb ]] || pb=$(pacman -Qqo "$MOD_ROOT/$k/modules.builtin" 2>/dev/null)
    printf '%s\n' "$pb"
}

# The part of a kernel release that names its flavor, as a regex that matches
# any version of it: 6.12.58-1-lts -> -[0-9]+-lts, 7.2.15-arch1-1 ->
# -arch[0-9]+-[0-9]+, 6.17.8-zen1-1-zen -> -zen[0-9]+-[0-9]+-zen.
flavor_suffix() {
    [[ $1 =~ ^[0-9]+(\.[0-9]+)*(-[A-Za-z0-9._+-]+)$ ]] || return 1
    sed -E 's/[.+]/\\&/g; s/[0-9]+/[0-9]+/g' <<<"${BASH_REMATCH[2]}"
}

# BUILD_EXCLUSIVE_KERNEL regex for the given (eligible) kernels: their flavors at
# any version, so the official DKMS hook also builds after kernel updates. Falls
# back to the exact releases if a flavor pattern would also match an installed
# kernel that must not be built for. '^$' (matches nothing) for no kernels.
exclusive_regex() {
    local k s regex=''
    local -a suffixes=()
    (( $# )) || { printf '%s\n' '^$'; return 0; }
    for k in "$@"; do
        s=$(flavor_suffix "$k") || { suffixes=(); break; }
        suffixes+=("$s")
    done
    if (( ${#suffixes[@]} )); then
        regex="^[0-9]+(\\.[0-9]+)*($(printf '%s\n' "${suffixes[@]}" | LC_ALL=C sort -u | paste -sd'|'))\$"
        while read -r k; do
            in_list "$k" "$@" && continue
            if [[ $k =~ $regex ]]; then
                regex=''
                break
            fi
        done < <(installed_kernels)
    fi
    if [[ -z $regex ]]; then
        regex="^($(printf '%s\n' "$@" | sed -E 's/[.+]/\\&/g' | LC_ALL=C sort -u | paste -sd'|'))\$"
    fi
    printf '%s\n' "$regex"
}

# Installed kernels (not EAC) left without any nvidia module source: no headers
# for DKMS and no prebuilt package.
uncovered_kernels() {
    local k
    while read -r k; do
        is_eac_kernel "$k" || has_headers "$k" || has_prebuilt_module "$k" || printf '%s\n' "$k"
    done < <(installed_kernels)
}

# ---- the managed source tree ------------------------------------------------

# /usr/src/nvidia-* trees managed by this script: marked and owned by no package.
managed_trees() {
    local d
    for d in "$SRC_ROOT/$MOD"-*/; do
        d=${d%/}
        [[ -f $d/$MARKER && -f $d/dkms.conf ]] || continue
        owned_by_package "$d/dkms.conf" && continue
        printf '%s\n' "$d"
    done
}

tree_version() {
    printf '%s\n' "${1##*/"$MOD"-}"
}

# The BUILD_EXCLUSIVE_KERNEL regex in this script's block of a dkms.conf.
current_exclusive() {
    [[ -f $1 ]] || return 0
    sed -n "/^$BLOCK_BEGIN\$/,/^$BLOCK_END\$/s/^BUILD_EXCLUSIVE_KERNEL='\\(.*\\)'\$/\\1/p" "$1"
}

# Replace this script's block at the end of a dkms.conf.
set_exclusive() {
    local conf=$1 regex=$2 tmp
    tmp=$(mktemp "$conf.XXXXXX") || return 1
    {
        # Everything before our block, without trailing blank lines.
        awk -v b="$BLOCK_BEGIN" '
            $0 == b { exit }
            /^[[:space:]]*$/ { blank = blank $0 "\n"; next }
            { printf "%s", blank; blank = ""; print }
        ' "$conf"
        echo
        echo "$BLOCK_BEGIN"
        echo "# Managed by $ME: build only for kernels without a prebuilt module."
        echo "BUILD_EXCLUSIVE_KERNEL='$regex'"
        echo "$BLOCK_END"
    } >"$tmp" && chmod 644 "$tmp" && mv -f -- "$tmp" "$conf" && return 0
    rm -f -- "$tmp"
    return 1
}

# ---- dkms -------------------------------------------------------------------

dkms_registered() {
    [[ -n $(dkms status -m "$MOD" -v "$1" 2>/dev/null) ]]
}

# DKMS state of nvidia/<ver> for kernel <kver>: installed, built, added or empty.
dkms_state() {
    local out re=': ([a-z]+)'
    out=$(dkms status -m "$MOD" -v "$1" -k "$2" 2>/dev/null)
    [[ $out =~ $re ]] && printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
}

# Kernels nvidia/<ver> is built or installed for.
dkms_kernels() {
    local line re="^$MOD/$1, ([^,]+), [^:]+: (built|installed)"
    while read -r line; do
        [[ $line =~ $re ]] && printf '%s\n' "${BASH_REMATCH[1]}"
    done < <(dkms status -m "$MOD" -v "$1" 2>/dev/null)
}

dkms_remove_version() {
    dkms_registered "$1" || return 0
    run dkms remove "$MOD/$1" --all
}

show_build_log() {
    local f
    for f in /var/lib/dkms/"$MOD"/"$1"/build/make.log /var/lib/dkms/"$MOD"/"$1"/*/*/log/make.log; do
        [[ -f $f ]] || continue
        err "last lines of $f:"
        tail -n 40 -- "$f" >&2
    done
}

# Build (not install) nvidia/<ver> for each kernel.
build_for() {
    local ver=$1 k st
    shift
    dkms_registered "$ver" || run dkms add "$MOD/$ver" || return 1
    for k in "$@"; do
        st=$(dkms_state "$ver" "$k")
        [[ $st == built || $st == installed ]] && continue
        run dkms build "$MOD/$ver" -k "$k" || return 1
    done
}

install_for() {
    local ver=$1 k
    shift
    for k in "$@"; do
        [[ $(dkms_state "$ver" "$k") == installed ]] && continue
        run dkms install "$MOD/$ver" -k "$k" || return 1
        REBUILT+=("$k")
    done
}

# Remove managed trees other than $1, with their DKMS entries.
remove_other_trees() {
    local old
    local -a trees=()
    mapfile -t trees < <(managed_trees)
    for old in "${trees[@]}"; do
        [[ $old == "$1" ]] && continue
        log "removing old $old"
        if dkms_remove_version "$(tree_version "$old")"; then
            rm -rf -- "$old"
        else
            warn "dkms remove failed for $old; left it in place"
        fi
    done
}

# ---- download ---------------------------------------------------------------

# Download DKMS_PKG with pacman itself into $TMP/cache and print its path.
# A throwaway dbpath (copy of the sync DBs, empty local DB) gives it its own
# lock, so this also works inside a pacman hook. pacman verifies the signature
# (SigLevel = Required) and fails over between mirrors.
fetch_pkg() {
    local want=$1 f
    mkdir -p "$TMP/db" "$TMP/cache" || return 1
    cp -a /var/lib/pacman/sync "$TMP/db/" || return 1
    log "downloading $DKMS_PKG $want with pacman"
    pacman -Sddw --noconfirm --noprogressbar --dbpath "$TMP/db" \
        --cachedir "$TMP/cache" --logfile /dev/null "$DKMS_PKG" >&2 || return 1
    for f in "$TMP/cache/$DKMS_PKG-$want"-*.pkg.tar.*; do
        [[ $f == *.sig ]] && continue
        printf '%s\n' "$f"
        return 0
    done
    err "downloaded package not found in $TMP/cache"
    return 1
}

# Extract usr/src/nvidia-<ver> into $TMP/root, check it, add the kernel block
# and the marker. Prints the staged tree path.
stage_tree() {
    local pkg=$1 ver=$2 full=$3 regex=$4 t pv
    mkdir -p "$TMP/root" || return 1
    bsdtar -xf "$pkg" -C "$TMP/root" "usr/src/$MOD-$ver" || return 1
    t=$TMP/root/usr/src/$MOD-$ver
    if [[ ! -f $t/dkms.conf ]]; then
        err "package has no usr/src/$MOD-$ver/dkms.conf"
        return 1
    fi
    pv=$(grep -m1 '^PACKAGE_VERSION=' "$t/dkms.conf")
    pv=${pv#PACKAGE_VERSION=}
    pv=${pv//\"/}
    pv=${pv//\'/}
    if [[ $pv != "$ver" ]]; then
        err "dkms.conf PACKAGE_VERSION is '$pv', expected '$ver'"
        return 1
    fi
    if grep -q '^[[:space:]]*BUILD_EXCLUSIVE_KERNEL=' "$t/dkms.conf"; then
        warn "upstream dkms.conf now sets BUILD_EXCLUSIVE_KERNEL; $ME overrides it"
    fi
    set_exclusive "$t/dkms.conf" "$regex" || return 1
    printf '%s\n' "$full" >"$t/$MARKER" || return 1
    printf '%s\n' "$t"
}

# ---- initramfs --------------------------------------------------------------

utils_ships_firmware() {
    local f
    while read -r f; do
        [[ $f == /usr/lib/firmware/*[!/] ]] && return 0
    done < <(pacman -Qlq "$UTILS_PKG" 2>/dev/null)
    return 1
}

# chwd puts nvidia into every initramfs (/etc/mkinitcpio.conf.d/10-chwd.conf),
# so a kernel whose module changed needs a new initramfs.
regen_initramfs() {
    (( $# )) || return 0
    if (( HOOK_MODE )) && in_list "$UTILS_PKG" "${HOOK_TARGETS[@]}" && utils_ships_firmware; then
        log "initramfs: 90-mkinitcpio-install runs next ($UTILS_PKG firmware changed) and rebuilds all kernels"
        return 0
    fi
    local k pb out
    local -a pkgs=()
    for k in "$@"; do
        pb=$(kernel_pkgbase "$k")
        if [[ -n $pb ]]; then
            in_list "$pb" "${pkgs[@]}" || pkgs+=("$pb")
        else
            warn "no package owns kernel $k; regenerate its initramfs yourself"
        fi
    done
    (( ${#pkgs[@]} )) || return 0
    if ! command -v limine-mkinitcpio >/dev/null; then
        warn "limine-mkinitcpio not found; regenerate the initramfs for: ${pkgs[*]}"
        return 1
    fi
    log "limine-mkinitcpio ${pkgs[*]}"
    # Capture, then print through the inherited fd: inside a pacman hook stderr
    # is a socket, which can't be reopened as /dev/stderr (so no tee).
    out=$(limine-mkinitcpio "${pkgs[@]}" 2>&1)
    printf '%s\n' "$out" >&2
    if [[ $out == *"mkinitcpio failed"* || $out == *"module not found"* ]]; then
        warn "initramfs generation reported errors for: ${pkgs[*]}"
        return 1
    fi
}

# ---- commands ---------------------------------------------------------------

cmd_sync() {
    if [[ ${1:-} == --hook ]]; then
        HOOK_MODE=1
        # The hook uses NeedsTargets: pacman passes the triggering targets.
        [[ -t 0 ]] || mapfile -t HOOK_TARGETS
    fi
    need_root sync
    take_lock

    detect_driver || fail "$(no_driver_msg)"
    if pacman -Q "$DKMS_PKG" &>/dev/null; then
        fail "the official $DKMS_PKG is installed, so this workaround is obsolete. Remove it (see: $ME help)"
    fi
    pacman -Q dkms &>/dev/null || fail "dkms is not installed. Run: sudo pacman -S --needed --asexplicit dkms"

    local want ver avail full tree cur regex k pkg staged missing fresh=0
    local -a kernels=() extra=()
    want=$(pkg_version "$UTILS_PKG") || fail "$UTILS_PKG is not installed"
    ver=$(upstream_version "$want")
    tree=$SRC_ROOT/$MOD-$ver

    cur=
    if [[ -d $tree ]]; then
        if [[ ! -f $tree/$MARKER ]] || owned_by_package "$tree/dkms.conf"; then
            fail "$tree exists but is not managed by $ME; refusing to touch it"
        fi
        cur=$(<"$tree/$MARKER")
    fi

    mapfile -t kernels < <(eligible_kernels)
    regex=$(exclusive_regex "${kernels[@]}")
    for k in $(dkms_kernels "$ver"); do
        in_list "$k" "${kernels[@]}" || extra+=("$k")
    done

    if (( ${#kernels[@]} == 0 )) && [[ -z $cur ]]; then
        remove_other_trees ''
        log "no kernel needs a DKMS build (each one has a prebuilt module or no headers)"
        warn_uncovered
        return 0
    fi

    # The DKMS package release to use: the repo's if it is for this driver
    # version, else the tree already extracted for it (repo ahead or behind).
    avail=$(repo_version "$DKMS_PKG") || avail=
    if [[ -n $avail && $(upstream_version "$avail") == "$ver" ]]; then
        full=$avail
    elif [[ -n $cur ]]; then
        full=$cur
    else
        fail "$UTILS_PKG $want needs $DKMS_PKG $ver, but the repo has ${avail:-no $DKMS_PKG} (stale sync DB, or published at different times). Retry after the next pacman -Syu"
    fi

    missing=0
    for k in "${kernels[@]}"; do
        [[ $(dkms_state "$ver" "$k") == installed ]] || missing=1
    done
    if [[ $cur == "$full" ]] && (( ! missing && ${#extra[@]} == 0 )) \
        && [[ $(current_exclusive "$tree/dkms.conf") == "$regex" && $(managed_trees) == "$tree" ]]; then
        log "$DKMS_PKG $full is up to date for: ${kernels[*]:-no kernel}"
        warn_uncovered
        return 0
    fi

    # Download and stage before touching anything, so a failed download (the
    # likeliest failure) leaves the installed module as it was.
    if [[ $cur != "$full" ]]; then
        make_tmp || fail "cannot create a staging directory in $STAGE_PARENT"
        pkg=$(fetch_pkg "$full") || fail "download of $DKMS_PKG $full failed"
        staged=$(stage_tree "$pkg" "$ver" "$full" "$regex") || fail "extracting $DKMS_PKG failed"
        if [[ -n $cur ]]; then
            # Same pkgver, new pkgrel: DKMS can't hold both, so the old one goes first.
            log "replacing $tree ($cur -> $full)"
            dkms_remove_version "$ver" || fail "dkms remove $MOD/$ver failed"
            rm -rf -- "$tree"
            extra=()
        fi
        mv -T -- "$staged" "$tree" || fail "cannot move the source tree to $tree"
        cleanup
        fresh=1
        log "extracted $tree"
    elif [[ $(current_exclusive "$tree/dkms.conf") != "$regex" ]]; then
        set_exclusive "$tree/dkms.conf" "$regex" || fail "cannot update $tree/dkms.conf"
    fi
    log "DKMS builds for kernels matching: $regex"

    REBUILT=()
    # Kernels that stopped qualifying (e.g. got a prebuilt module) lose our build.
    for k in "${extra[@]}"; do
        if run dkms remove "$MOD/$ver" -k "$k"; then
            [[ -d $MOD_ROOT/$k/kernel ]] && REBUILT+=("$k")
        else
            warn "dkms remove $MOD/$ver -k $k failed"
        fi
    done

    # Build first; only swap out the old version once the new one built.
    if ! build_for "$ver" "${kernels[@]}"; then
        show_build_log "$ver"
        if (( fresh )); then
            dkms_remove_version "$ver"
            rm -rf -- "$tree"
            err "removed the new $tree; any previously installed version is untouched"
        fi
        fail "dkms build of $MOD/$ver failed"
    fi
    remove_other_trees "$tree"
    install_for "$ver" "${kernels[@]}" || fail "dkms install of $MOD/$ver failed"
    log "$DKMS_PKG $full installed for: ${kernels[*]:-no kernel}"
    regen_initramfs "${REBUILT[@]}" || warn "check the initramfs, then: sudo limine-mkinitcpio"
    warn_uncovered
    return 0
}

warn_uncovered() {
    local k pb
    while read -r k; do
        pb=$(kernel_pkgbase "$k")
        warn "kernel $k has no nvidia module: install ${pb:-its}-headers so DKMS can build for it"
    done < <(uncovered_kernels)
}

# Remove the managed source trees and their DKMS entries. Keeps script and hook.
clean_trees() {
    local t v rc=0
    local -a trees=()
    mapfile -t trees < <(managed_trees)
    for t in "${trees[@]}"; do
        v=$(tree_version "$t")
        if dkms_remove_version "$v"; then
            rm -rf -- "$t"
            log "removed $t"
        else
            err "dkms remove $MOD/$v failed; left $t in place"
            rc=1
        fi
    done
    return $rc
}

after_clean_notes() {
    local dkms_pkg='the official NVIDIA DKMS package'
    detect_driver && dkms_pkg=$DKMS_PKG
    log "notes:"
    log "  - kernels without a prebuilt module now have no nvidia module, so their initramfs"
    log "    can't be built (chwd adds nvidia to it): install $dkms_pkg before the next kernel update"
    log "  - dkms stays installed ($dkms_pkg needs it), and so does DKMS's signing key in /var/lib/dkms"
    log "  - with $dkms_pkg installed, DKMS builds for every kernel with headers, also those with a"
    log "    prebuilt linux-cachyos-nvidia-* module, which it then overrides: keep only one of the two"
}

cmd_clean() {
    need_root clean
    take_lock
    clean_trees || return 1
    after_clean_notes
}

print_hook() {
    local exec=$1
    cat <<EOF
# pacman hook of $ME: keep the DKMS NVIDIA module in sync with the
# NVIDIA driver and with the installed kernels and prebuilt modules.
[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
$(utils_packages | sed 's/^/Target = /')
$(printf 'Target = %s\n' "${PKG_NAMES[@]}")

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/build/include/
Target = usr/lib/modules/*/extramodules/$MOD.ko*

[Action]
Description = Syncing NVIDIA DKMS modules for kernels without a prebuilt module ($ME)...
When = PostTransaction
Exec = $exec sync --hook
NeedsTargets
# pacman >= 7.1 runs hooks without network unless allowed; sync downloads the
# DKMS package with pacman.
NetworkAccess = allowed
EOF
}

write_hook() {
    mkdir -p -- "${HOOK_DEST%/*}" || return 1
    print_hook "$SELF_DEST" >"$HOOK_DEST.tmp" || return 1
    chmod 644 "$HOOK_DEST.tmp" && mv -f -- "$HOOK_DEST.tmp" "$HOOK_DEST"
}

cmd_install() {
    need_root install
    local pkg src
    pkg=$(installed_as_package)
    if [[ -n $pkg ]]; then
        log "$ME is installed by the $pkg package; nothing to install, running sync"
        cmd_sync
        return
    fi
    if ! detect_driver; then
        err "$(no_driver_msg)"
        exit 1
    fi
    if ! pacman -Q dkms &>/dev/null; then
        err "dkms is not installed. Run first: sudo pacman -S --needed --asexplicit dkms"
        exit 1
    fi
    if dkms_is_orphan; then
        # Orphan cleanup would remove dkms; nothing else needs it.
        run pacman -D --asexplicit dkms >/dev/null || warn "could not mark dkms as explicitly installed"
    fi
    src=$(readlink -f -- "${BASH_SOURCE[0]}")
    if [[ $src != "$SELF_DEST" ]]; then
        install -Dm755 -- "$src" "$SELF_DEST" || { err "cannot install $SELF_DEST"; exit 1; }
        log "installed $SELF_DEST"
    fi
    write_hook || { err "cannot write $HOOK_DEST"; exit 1; }
    log "installed $HOOK_DEST"
    cmd_sync
}

cmd_uninstall() {
    need_root uninstall
    local pkg
    pkg=$(installed_as_package)
    if [[ -n $pkg ]]; then
        err "$ME is installed by the $pkg package. Run: sudo pacman -R $pkg"
        err "(its pre_remove step removes the managed source trees first)"
        exit 1
    fi
    take_lock
    if ! clean_trees; then
        err "kept $HOOK_DEST and $SELF_DEST; fix the error above and run uninstall again"
        return 1
    fi
    rm -f -- "$HOOK_DEST" "$HOOK_DEST.tmp"
    log "removed $HOOK_DEST"
    after_clean_notes
    if [[ -e $SELF_DEST ]]; then
        rm -f -- "$SELF_DEST"
        log "removed $SELF_DEST"
    fi
    return 0
}

cmd_status() {
    local want='' avail='' ver='' pkg t m k pb path kind mver conf c n regex problems=0
    local -a active=() trees=()

    echo "== $ME status"
    if detect_driver; then
        want=$(pkg_version "$UTILS_PKG")
        avail=$(repo_version "$DKMS_PKG") || avail=
        ver=$(upstream_version "$want")
        printf '  %-26s %s\n' "$UTILS_PKG" "$want"
        printf '  %-26s %s\n' "$DKMS_PKG (repo)" "${avail:-not in sync DB}"
        if [[ -n $avail && $(upstream_version "$avail") != "$ver" ]]; then
            echo "  !! repo $DKMS_PKG is for driver $(upstream_version "$avail"), userspace is $ver (update both with pacman -Syu)"
            (( problems++ ))
        fi
    else
        echo "  !! $(no_driver_msg)"
        (( problems++ ))
    fi

    pkg=$(installed_as_package)
    if [[ -n $pkg ]]; then
        printf '  %-26s %s\n' "installed as" "package $pkg $(pkg_version "$pkg")"
        if [[ -e $HOOK_DEST || -e $SELF_DEST ]]; then
            echo "  !! a manual install is also present and its hook overrides the package's: sudo rm -f $HOOK_DEST $SELF_DEST"
            (( problems++ ))
        fi
    elif [[ -e $HOOK_DEST ]]; then
        printf '  %-26s %s\n' "installed as" "manual install ($SELF_DEST)"
    else
        printf '  %-26s %s\n' "installed as" "not installed (no pacman hook)"
        (( problems++ ))
    fi
    for t in "$HOOK_DEST" "$PKG_HOOK"; do
        [[ -f $t ]] && printf '  %-26s %s\n' "pacman hook" "$t"
    done

    if ! pacman -Q dkms &>/dev/null; then
        printf '  %-26s %s\n' "dkms" "NOT installed (kernel updates won't rebuild nvidia)"
        (( problems++ ))
    elif dkms_is_orphan; then
        printf '  %-26s %s\n' "dkms" "orphan; cleanup may remove it: sudo pacman -D --asexplicit dkms"
        (( problems++ ))
    else
        printf '  %-26s %s\n' "dkms" "installed"
    fi

    echo "== managed source trees"
    mapfile -t trees < <(managed_trees)
    (( ${#trees[@]} )) || echo "  none"
    for t in "${trees[@]}"; do
        m=$(<"$t/$MARKER")
        if [[ $(upstream_version "$m") == "$ver" ]]; then
            echo "  $t ($m, matches the driver)"
        else
            echo "  $t ($m) !! driver is ${ver:-not installed}; run: sudo $ME sync"
            (( problems++ ))
        fi
        regex=$(current_exclusive "$t/dkms.conf")
        echo "    builds for kernels matching: ${regex:-?}"
    done

    echo "== dkms status"
    if command -v dkms >/dev/null; then
        dkms status 2>&1 | sed 's/^/  /'
    fi

    echo "== nvidia module per kernel"
    while read -r k; do
        pb=$(kernel_pkgbase "$k")
        path=$(modinfo -k "$k" -n "$MOD" 2>/dev/null)
        case $path in
            */updates/dkms/*) kind=dkms ;;
            */extramodules/*) kind=prebuilt ;;
            '')
                if is_eac_kernel "$k"; then
                    kind="MISSING: install its linux-cachyos-eac-nvidia-* package"
                elif ! has_headers "$k"; then
                    kind="MISSING: install ${pb:-its}-headers so DKMS can build for it"
                else
                    kind="MISSING: run sudo $ME sync"
                fi
                kind+=" (mkinitcpio fails for this kernel and limine keeps a stale boot entry)"
                (( problems++ )) ;;
            *) kind="other: $path" ;;
        esac
        if [[ -n $path ]]; then
            mver=$(modinfo -k "$k" -F version "$MOD" 2>/dev/null)
            if [[ -n $ver && $mver != "$ver" ]]; then
                kind+=" !! module $mver, userspace $ver"
                (( problems++ ))
            else
                kind+=" ($mver)"
            fi
            n=0
            for t in "$MOD_ROOT/$k/updates/dkms/$MOD".ko* "$MOD_ROOT/$k/extramodules/$MOD".ko*; do
                (( n++ ))
            done
            if (( n > 1 )); then
                kind+=" !! DUPLICATE: both a DKMS and a prebuilt nvidia.ko; run: sudo $ME sync"
                (( problems++ ))
            fi
        fi
        printf '  %-24s %-20s %s\n' "$k" "${pb:-?}" "$kind"
    done < <(installed_kernels)

    if pacman -Q linux-cachyos-eac-headers &>/dev/null; then
        echo "  !! linux-cachyos-eac-headers is installed; remove it, the EAC kernel must only use the prebuilt module"
        (( problems++ ))
    fi

    echo "== official fix"
    if [[ -z $DKMS_PKG ]]; then
        echo "  unknown (no supported driver detected)"
    elif conf=$(LC_ALL=C pacman -Si "$DKMS_PKG" 2>/dev/null | sed -n 's/^Conflicts With *: //p' | head -n1) && [[ -n $conf ]]; then
        for c in $conf; do
            [[ $c == None ]] && continue
            pacman -T "$c" &>/dev/null && active+=("$c")
        done
        if (( ${#active[@]} )); then
            echo "  not yet: $DKMS_PKG still conflicts with installed ${active[*]}"
        else
            echo "  LIKELY LANDED: $DKMS_PKG no longer conflicts with anything installed."
            if [[ -n $pkg ]]; then
                echo "  Run 'sudo pacman -R $pkg' FIRST, then 'sudo pacman -S $DKMS_PKG'."
            else
                echo "  Run 'sudo $ME uninstall' FIRST, then 'sudo pacman -S $DKMS_PKG'."
            fi
        fi
    else
        echo "  unknown ($DKMS_PKG not in the sync databases)"
    fi

    echo "== $( (( problems )) && echo "$problems problem(s) found" || echo "all good")"
    (( problems == 0 ))
}

# Diagnostic: download and verify the DKMS package only, then clean up.
cmd_fetch_test() {
    need_root fetch-test
    local avail pkg ver
    detect_driver || { err "$(no_driver_msg)"; exit 1; }
    avail=$(repo_version "$DKMS_PKG") || { err "$DKMS_PKG is not in the sync databases"; exit 1; }
    ver=$(upstream_version "$avail")
    make_tmp || exit 1
    pkg=$(fetch_pkg "$avail") || { err "download failed"; exit 1; }
    log "downloaded and signature-checked: ${pkg##*/} ($(du -h -- "$pkg" | cut -f1))"
    if bsdtar -tf "$pkg" "usr/src/$MOD-$ver/dkms.conf" >/dev/null; then
        log "archive contains usr/src/$MOD-$ver/dkms.conf"
    fi
    log "removing $TMP"
}

usage() {
    cat <<EOF
usage: $ME <command>

  status      show what the workaround manages and check for problems
  sync        make the DKMS nvidia source match the installed NVIDIA driver and
              build it for every kernel that has headers and no prebuilt module
              (--hook: used by the pacman hook, always exits 0)
  clean       remove the managed source trees and their DKMS entries
  fetch-test  download and signature-check the DKMS package only (diagnostic)
  print-hook <path>
              print the pacman hook, with Exec pointing at <path> (packaging)

Manual install (not needed when installed as a package):
  install     copy this script to $SELF_DEST, write $HOOK_DEST, then sync
  uninstall   clean, then remove that script and hook

Driver lines (picked from the installed userspace package):
$(for e in "${DRIVERS[@]}"; do read -r u d <<<"$e"; printf '  %-20s -> %s\n' "$u" "$d"; done)
EOF
}

main() {
    local cmd=${1:-}
    (( $# )) && shift
    case $cmd in
        install) cmd_install ;;
        sync) cmd_sync "$@" ;;
        status) cmd_status ;;
        clean) cmd_clean ;;
        uninstall) cmd_uninstall ;;
        fetch-test) cmd_fetch_test ;;
        print-hook) print_hook "${1:-/usr/bin/$ME}" ;;
        ''|-h|--help|help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

# Run only when executed, so tests can source the functions. The whole if-block
# is parsed before it runs, so `uninstall` deleting this file is safe.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
    exit
fi
