_manual_install_leftovers() {
    if [ -e /etc/pacman.d/hooks/80-eac-dkms-workaround.hook ] || [ -e /usr/local/bin/eac-dkms-workaround ]; then
        echo '==> WARNING: a manual install of eac-dkms-workaround is present and its hook'
        echo '    overrides the one from this package. Remove it with:'
        echo '      sudo rm -f /etc/pacman.d/hooks/80-eac-dkms-workaround.hook /usr/local/bin/eac-dkms-workaround'
    fi
}

post_install() {
    echo '==> eac-dkms-workaround: its pacman hook builds the NVIDIA DKMS module, at the'
    echo '    end of this transaction, for every kernel that has headers and no prebuilt'
    echo '    module (linux, linux-lts, linux-zen, ...). Install <kernel>-headers for'
    echo '    each such kernel. Check the result with:'
    echo '      eac-dkms-workaround status'
    _manual_install_leftovers
}

post_upgrade() {
    _manual_install_leftovers
}

pre_remove() {
    # Remove the extracted /usr/src/nvidia-* trees and their DKMS entries while
    # the script is still installed.
    /usr/bin/eac-dkms-workaround clean
}
